#!/command/with-contenv sh
# Prepare the database directory.
#
# Three jobs: refuse to run without a real volume, initialise the data
# directory on a first run, and handle the server having been upgraded
# under an existing one.
set -eu

DATA_DIR=/var/lib/mysql
DB_NAME="${KPWPVS_DATABASE_NAME:-kpwpvs}"
DB_USER="${KPWPVS_DATABASE_USER:-kpwpvs}"
DB_PASS="${KPWPVS_DATABASE_PASSWORD:-}"

# nothing to do at all when the database lives somewhere else
if [ "${KPWPVS_DATABASE_EMBEDDED:-true}" = "false" ]; then
    echo "[init-db] embedded server disabled, nothing to prepare"
    exit 0
fi

# the catalog takes minutes to rebuild and the findings carry work people
# have done by hand. writing that into the container layer would lose all
# of it on the next image pull, silently, so refuse instead
if ! mountpoint -q "$DATA_DIR" 2>/dev/null; then
    if [ "${KPWPVS_ALLOW_EPHEMERAL_DB:-false}" != "true" ]; then
        cat >&2 <<'MSG'
[init-db] FATAL: /var/lib/mysql is not a mounted volume.

Everything this tool builds would be lost the next time the image is
pulled, without warning. Mount a volume there:

    podman run -v kpwpvs-db:/var/lib/mysql ...

Set KPWPVS_ALLOW_EPHEMERAL_DB=true if you genuinely want throwaway
storage, for a test run or a demo.
MSG
        exit 1
    fi
    echo "[init-db] WARNING: /var/lib/mysql is not a volume, this data will not survive"
fi

if [ -z "$DB_PASS" ]; then
    echo "[init-db] FATAL: set KPWPVS_DATABASE_PASSWORD" >&2
    exit 1
fi

mkdir -p /run/mysqld
chown mysql:mysql /run/mysqld

# first run, so lay the data directory down
if [ ! -d "$DATA_DIR/mysql" ]; then
    echo "[init-db] initialising a new data directory"
    chown -R mysql:mysql "$DATA_DIR"
    mariadb-install-db --user=mysql --datadir="$DATA_DIR" --auth-root-authentication-method=socket >/dev/null

    echo "[init-db] creating the database and its user"
    /usr/sbin/mariadbd --user=mysql --datadir="$DATA_DIR" --socket=/run/mysqld/mysqld.sock \
        --skip-networking --skip-grant-tables=0 &
    BOOT_PID=$!

    for _ in $(seq 1 60); do
        mariadb-admin --socket=/run/mysqld/mysqld.sock ping >/dev/null 2>&1 && break
        sleep 1
    done

    mariadb --socket=/run/mysqld/mysqld.sock <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASS}';
CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'localhost';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

    mariadb-admin --socket=/run/mysqld/mysqld.sock shutdown
    wait "$BOOT_PID" 2>/dev/null || true
    echo "[init-db] data directory ready"
    exit 0
fi

chown -R mysql:mysql "$DATA_DIR" 2>/dev/null || true

# the data directory already exists. if the image has been updated to a
# newer mariadb since it was written, it needs upgrading, and a dump goes
# next to it first because that is not a reversible operation
STAMP="$DATA_DIR/.kpwpvs-mariadb-version"
CURRENT="$(mariadbd --version | sed -n 's/.*Ver \([0-9.]*\).*/\1/p')"
PREVIOUS="$(cat "$STAMP" 2>/dev/null || echo unknown)"

if [ "$PREVIOUS" != "$CURRENT" ]; then
    echo "[init-db] mariadb changed from ${PREVIOUS} to ${CURRENT}, upgrading"

    /usr/sbin/mariadbd --user=mysql --datadir="$DATA_DIR" --socket=/run/mysqld/mysqld.sock --skip-networking &
    BOOT_PID=$!
    for _ in $(seq 1 60); do
        mariadb-admin --socket=/run/mysqld/mysqld.sock ping >/dev/null 2>&1 && break
        sleep 1
    done

    if [ "$PREVIOUS" != "unknown" ]; then
        DUMP="$DATA_DIR/pre-upgrade-${PREVIOUS}-to-${CURRENT}.sql.gz"
        echo "[init-db] dumping to ${DUMP} before touching anything"
        mariadb-dump --socket=/run/mysqld/mysqld.sock --all-databases --single-transaction \
            | gzip > "$DUMP" || echo "[init-db] WARNING: the dump failed, continuing anyway"
    fi

    mariadb-upgrade --socket=/run/mysqld/mysqld.sock || echo "[init-db] mariadb-upgrade reported problems"
    mariadb-admin --socket=/run/mysqld/mysqld.sock shutdown
    wait "$BOOT_PID" 2>/dev/null || true
fi

echo "$CURRENT" > "$STAMP"
echo "[init-db] data directory ready (mariadb ${CURRENT})"
