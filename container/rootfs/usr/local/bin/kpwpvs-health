#!/command/with-contenv sh
# Healthcheck.
#
# Checks the interface answers and the schema is current, which together
# mean the thing is actually usable rather than merely running.
set -eu

kpwpvs db status >/dev/null 2>&1 || exit 1

PORT="$(printf '%s' "${KPWPVS_WEB_PORT:-8080}")"
exec python -c "
import sys, urllib.request
try:
    with urllib.request.urlopen('http://127.0.0.1:${PORT}/login', timeout=5) as r:
        sys.exit(0 if r.status < 500 else 1)
except Exception:
    sys.exit(1)
"
