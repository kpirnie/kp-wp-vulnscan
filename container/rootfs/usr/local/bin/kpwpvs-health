#!/bin/sh
# Healthcheck.
#
# Deliberately a plain shell script rather than an s6 with-contenv one.
# A healthcheck runs outside the supervision tree, where execline's
# helpers are not on the path, so with-contenv fails before it starts.
#
# Checks both that the schema is current and that the interface answers,
# which together mean the thing is usable rather than merely running.
set -eu

PATH="/opt/venv/bin:$PATH"
export PATH

kpwpvs db status >/dev/null 2>&1 || exit 1

exec python -c "
import os, sys, urllib.request
port = os.environ.get('KPWPVS_WEB_PORT', '8080')
try:
    with urllib.request.urlopen(f'http://127.0.0.1:{port}/login', timeout=5) as response:
        sys.exit(0 if response.status < 500 else 1)
except Exception:
    sys.exit(1)
"
